<!--
  UI/MainWindow.xaml
  Ventana principal de OptiLow. Tema oscuro con colores definidos como recursos (sin librerías externas).
  Reglas de la fase 5:
    - Sin efectos pesados: nada de sombras, desenfoques, Effect, AllowsTransparency, animaciones ni imágenes.
      Todo es de colores sólidos (Pruebas/Probar-Fase5.ps1 busca esos elementos y falla si aparece alguno).
    - Todos los controles que el código usa tienen x:Name (se localizan con FindName).
    - Funciona de 860x460 hacia arriba (1366x768 con escala del 150 % deja unas 911x485): el contenido de cada
      vista vive dentro de un ScrollViewer y los botones están en WrapPanel.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="VentanaPrincipal"
        Title="OptiLow"
        Width="1000" Height="600" MinWidth="860" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#1E1F22" Foreground="#E3E5E8"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Colores -->
        <SolidColorBrush x:Key="BrushFondo" Color="#1E1F22"/>
        <SolidColorBrush x:Key="BrushPanel" Color="#2B2D31"/>
        <SolidColorBrush x:Key="BrushPanelAlt" Color="#35373C"/>
        <SolidColorBrush x:Key="BrushBorde" Color="#4A4D55"/>
        <SolidColorBrush x:Key="BrushTexto" Color="#E3E5E8"/>
        <SolidColorBrush x:Key="BrushTextoSuave" Color="#A9ADB5"/>
        <SolidColorBrush x:Key="BrushAcento" Color="#5B9DFF"/>
        <SolidColorBrush x:Key="BrushOk" Color="#57C078"/>
        <SolidColorBrush x:Key="BrushAviso" Color="#E8B04B"/>
        <SolidColorBrush x:Key="BrushError" Color="#F0616D"/>
        <SolidColorBrush x:Key="BrushInfo" Color="#5BB8E6"/>
        <SolidColorBrush x:Key="BrushSimulado" Color="#C58AF0"/>
        <SolidColorBrush x:Key="BrushBannerFondo" Color="#4A3B12"/>

        <!-- Indicador de foco: borde sólido, sin efectos -->
        <Style x:Key="EstiloFoco">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Stroke="{StaticResource BrushAcento}" StrokeThickness="2" Margin="-1"
                                   SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="Background" Value="{StaticResource BrushPanelAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFoco}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Marco" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource BrushAcento}"/>
                            </Trigger>
                            <Trigger Property="IsDefault" Value="True">
                                <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource BrushAcento}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6F737B"/>
                                <Setter TargetName="Marco" Property="Background" Value="{StaticResource BrushPanel}"/>
                                <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource BrushPanelAlt}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFoco}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFoco}"/>
            <Setter Property="Margin" Value="0,0,14,6"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        </Style>

        <!-- Elementos de lista (navegación, registro, sesiones) -->
        <Style x:Key="EstiloItemLista" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFoco}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Marco" Background="Transparent" BorderThickness="3,0,0,0"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Marco" Property="Background" Value="{StaticResource BrushPanelAlt}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Marco" Property="Background" Value="{StaticResource BrushPanelAlt}"/>
                                <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource BrushAcento}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFoco}"/>
        </Style>

        <!-- Barras de desplazamiento planas (las del sistema son claras) -->
        <Style x:Key="EstiloBotonPagina" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EstiloThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Pulgar" Background="{StaticResource BrushBorde}" CornerRadius="3" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pulgar" Property="Background" Value="{StaticResource BrushTextoSuave}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="PlantillaScrollV" TargetType="ScrollBar">
            <Grid Background="{StaticResource BrushPanel}">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource EstiloBotonPagina}" Command="ScrollBar.PageUpCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource EstiloThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource EstiloBotonPagina}" Command="ScrollBar.PageDownCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="PlantillaScrollH" TargetType="ScrollBar">
            <Grid Background="{StaticResource BrushPanel}">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource EstiloBotonPagina}" Command="ScrollBar.PageLeftCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource EstiloThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource EstiloBotonPagina}" Command="ScrollBar.PageRightCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template" Value="{StaticResource PlantillaScrollV}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="Template" Value="{StaticResource PlantillaScrollH}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorde}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Margin="12,0">
                <TextBlock x:Name="TxtTitulo" Text="OptiLow" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <TextBlock x:Name="TxtAdmin" Text="" VerticalAlignment="Center" Margin="16,0,0,0" DockPanel.Dock="Left" Foreground="{StaticResource BrushTextoSuave}"/>
                <TextBlock x:Name="TxtJournal" Text="" VerticalAlignment="Center" Margin="12,0,0,0" DockPanel.Dock="Left" Foreground="{StaticResource BrushTextoSuave}"/>
                <CheckBox x:Name="ChkSoftware" Content="Renderizado por software" VerticalAlignment="Center" DockPanel.Dock="Right" TabIndex="90"
                          ToolTip="Úsalo si la ventana se ve negra o con basura (drivers de video rotos). Se guarda y se aplica al reabrir."/>
            </DockPanel>
        </Border>

        <!-- Banners (visibles, no solo en el log) -->
        <StackPanel x:Name="PanelBanners" Grid.Row="1">
            <Border x:Name="BannerOtroUsuario" Visibility="Collapsed" Background="#5A2A2A" Padding="12,6">
                <TextBlock x:Name="TxtBannerOtroUsuario" TextWrapping="Wrap" Foreground="#FFD9D9"/>
            </Border>
            <Border x:Name="BannerJournal" Visibility="Collapsed" Background="{StaticResource BrushBannerFondo}" Padding="12,6">
                <TextBlock x:Name="TxtBannerJournal" TextWrapping="Wrap" Foreground="#FFE9B8"/>
            </Border>
            <Border x:Name="BannerSimulado" Visibility="Collapsed" Background="#3B2A52" Padding="12,6">
                <TextBlock x:Name="TxtBannerSimulado" TextWrapping="Wrap" Foreground="#EBD6FF"
                           Text="SIMULADO – solo para ver: con datos simulados no se puede aplicar ni deshacer nada."/>
            </Border>
        </StackPanel>

        <!-- Cuerpo: navegación + vistas -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorde}" BorderThickness="0,0,1,0">
                <ListBox x:Name="Navegacion" TabIndex="0" SelectedIndex="0" ItemContainerStyle="{StaticResource EstiloItemLista}"
                         KeyboardNavigation.DirectionalNavigation="Cycle" Margin="0,8,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBoxItem x:Name="NavDiagnostico"><TextBlock Text="Diagnóstico" TextWrapping="Wrap"/></ListBoxItem>
                    <ListBoxItem x:Name="NavOptimizaciones"><TextBlock Text="Optimizaciones" TextWrapping="Wrap"/></ListBoxItem>
                    <ListBoxItem x:Name="NavInicio"><TextBlock Text="Programas de inicio" TextWrapping="Wrap"/></ListBoxItem>
                    <ListBoxItem x:Name="NavRespaldo"><TextBlock Text="Respaldo y restauración" TextWrapping="Wrap"/></ListBoxItem>
                    <ListBoxItem x:Name="NavRegistro"><TextBlock Text="Registro" TextWrapping="Wrap"/></ListBoxItem>
                </ListBox>
            </Border>

            <Grid Grid.Column="1" Margin="14,10,14,8">
                <!-- Diagnóstico -->
                <Grid x:Name="VistaDiagnostico">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                        <Button x:Name="BtnActualizarDiag" Content="Ac_tualizar diagnóstico" TabIndex="10"/>
                        <StackPanel x:Name="PanelDemo" Orientation="Horizontal" Visibility="Collapsed" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Datos:" VerticalAlignment="Center" Margin="0,0,10,6" Foreground="{StaticResource BrushSimulado}"/>
                            <RadioButton x:Name="DemoReal" Content="Este equipo" GroupName="Demo" IsChecked="True" TabIndex="11"/>
                            <RadioButton x:Name="DemoBajo" Content="Simulado Bajo" GroupName="Demo" TabIndex="12"/>
                            <RadioButton x:Name="DemoMedio" Content="Simulado Medio" GroupName="Demo" TabIndex="13"/>
                            <RadioButton x:Name="DemoAlto" Content="Simulado Alto" GroupName="Demo" TabIndex="14"/>
                        </StackPanel>
                    </WrapPanel>
                    <ScrollViewer Grid.Row="1" x:Name="ScrollDiagnostico" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TabIndex="15">
                        <StackPanel x:Name="PanelDiagnostico" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtDiagEstado" Text="Diagnóstico pendiente…" Foreground="{StaticResource BrushTextoSuave}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Optimizaciones -->
                <Grid x:Name="VistaOptimizaciones" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,4">
                        <WrapPanel>
                            <Button x:Name="BtnSeleccionarRec" Content="_Seleccionar recomendadas" TabIndex="20"/>
                            <Button x:Name="BtnQuitarSel" Content="_Quitar selección" TabIndex="21"/>
                            <Button x:Name="BtnAplicar" Content="_Aplicar seleccionadas" TabIndex="22"/>
                            <CheckBox x:Name="ChkOmitirPunto" Content="Omitir el punto de restauración (no recomendado)" TabIndex="23" Margin="4,0,0,6" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <TextBlock x:Name="TxtSeleccion" Text="" Foreground="{StaticResource BrushTextoSuave}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtAyudaDeshacer" Foreground="{StaticResource BrushInfo}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="Para deshacer lo aplicado: pestaña «Respaldo y restauración» > «Deshacer última sesión»."
                                   />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" x:Name="ScrollOptimizaciones" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TabIndex="24">
                        <StackPanel x:Name="PanelOptimizaciones" Margin="0,0,8,0"/>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorde}" BorderThickness="1" Margin="0,8,0,0">
                        <ScrollViewer x:Name="ScrollDetalle" MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" IsTabStop="False">
                            <TextBlock x:Name="TxtDetalle" TextWrapping="Wrap" Padding="10,6"
                                       Text="Selecciona una optimización para ver qué hace y qué efecto secundario tiene."
                                       Foreground="{StaticResource BrushTextoSuave}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Programas de inicio (marcador hasta la fase 6) -->
                <Grid x:Name="VistaInicio" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="Programas de inicio" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtInicioMarcador" TextWrapping="Wrap" Foreground="{StaticResource BrushTextoSuave}"
                                   Text="Disponible en la fase 6. Aquí podrás ver y deshabilitar (sin borrar) lo que arranca con Windows, igual que el Administrador de tareas, y volver a habilitarlo."/>
                    </StackPanel>
                </Grid>

                <!-- Respaldo y restauración (mínimo) -->
                <Grid x:Name="VistaRespaldo" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,4">
                        <WrapPanel>
                            <Button x:Name="BtnActualizarSesiones" Content="Actuali_zar" TabIndex="30"/>
                            <Button x:Name="BtnDeshacer" Content="_Deshacer última sesión" TabIndex="31"/>
                        </WrapPanel>
                        <TextBlock x:Name="TxtRespaldoInfo" Text="" Foreground="{StaticResource BrushTextoSuave}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" x:Name="ScrollSesiones" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TabIndex="32">
                        <StackPanel x:Name="PanelSesiones" Margin="0,0,8,0"/>
                    </ScrollViewer>
                </Grid>

                <!-- Registro -->
                <Grid x:Name="VistaRegistro" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <Button x:Name="BtnCopiarLog" Content="_Copiar" TabIndex="40"/>
                        <Button x:Name="BtnAbrirLogs" Content="Abrir carpeta de _logs" TabIndex="41"/>
                        <Button x:Name="BtnLimpiarLog" Content="Limpiar _vista" TabIndex="42"/>
                    </WrapPanel>
                    <Border Grid.Row="1" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorde}" BorderThickness="1">
                        <ListBox x:Name="ListaLog" TabIndex="43" ItemContainerStyle="{StaticResource EstiloItemLista}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- Pantalla de "Cargando…": es parte de la propia ventana (no hay formulario aparte) -->
            <Grid x:Name="PanelCarga" Grid.ColumnSpan="2" Background="{StaticResource BrushFondo}" Panel.ZIndex="100">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Cargando OptiLow…" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtCarga" Text="" Foreground="{StaticResource BrushTextoSuave}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Barra de estado -->
        <Border Grid.Row="3" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorde}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0" LastChildFill="False">
                <TextBlock x:Name="TxtEstadoTrabajo" Text="Listo" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <TextBlock x:Name="TxtApertura" Text="" VerticalAlignment="Center" DockPanel.Dock="Right" Foreground="{StaticResource BrushTextoSuave}"/>
                <TextBlock x:Name="TxtRender" Text="" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="0,0,16,0" Foreground="{StaticResource BrushTextoSuave}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
